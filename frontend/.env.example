# URL backend khi deploy (ví dụ đã deploy backend lên Render):
#   NEXT_PUBLIC_API_URL=https://backend-cua-ban.onrender.com
#
# Không cần đặt khi chạy local — Next.js dev proxy tự chuyển '/api' sang localhost:4000.
# Trên Netlify: Site configuration → Environment variables → thêm NEXT_PUBLIC_API_URL rồi redeploy.
NEXT_PUBLIC_API_URL=
