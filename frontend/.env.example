# URL backend khi deploy (ví dụ đã deploy backend lên Render):
#   VITE_API_URL=https://backend-cua-ban.onrender.com
#
# Không cần đặt khi chạy local — Vite proxy tự chuyển '/api' sang localhost:4000.
# Trên Netlify: Site settings → Environment variables → thêm VITE_API_URL rồi redeploy.
VITE_API_URL=
